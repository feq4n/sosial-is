# Bu fayl yalnız data miqrasiyası üçündür. Real dəyərləri "migration/.env" kimi saxlayın (Git-ə düşmür).
# Skriptə bu dəyərləri mühit dəyişəni kimi verin:  set -a; source .env; set +a; npm run dry-run

# Firebase Console → Project settings → Service accounts → "Generate new private key" ilə endirilən JSON-un yolu.
# Skript Firebase-ə YALNIZ OXUMA sorğuları göndərir; Firebase-dəki heç nə dəyişdirilmir və silinmir.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://XXXXXXXX.supabase.co
# service_role / secret açarı: YALNIZ bu lokal skript üçün; brauzerə, frontend .env-ə və repoya YAZMAYIN.
SUPABASE_SERVICE_ROLE_KEY=

# Şifrə sıfırlama e-poçtlarındakı keçid üçün saytın ünvanı (məs. https://sosial-is.example.az)
SITE_URL=
