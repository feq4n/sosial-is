# Firebase Console → Project settings → Your apps → Web app
# Bu dəyərlər brauzerə açıq konfiqurasiyadır (məxfi açar deyil); icazələr firestore.rules ilə qorunur.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Rəsmi əlaqə məlumatları (boş buraxılsa, saytda göstərilmir)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=

# Sitemap üçün saytın tam ünvanı (məs. https://sosial-is.example.az). Vercel-də boş qala bilər.
SITE_URL=
